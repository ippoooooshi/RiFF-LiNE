{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/.tsc-node",
    "lib": ["ES2022"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/dev/**/*.ts",
    "scripts/run-app.mjs",
    "scripts/check-license-files.mjs",
    "scripts/check-doc-refs.mjs",
    "electron.vite.config.ts"
  ],
  "references": [{ "path": "../../packages/shared-types" }, { "path": "../../packages/core" }]
}
