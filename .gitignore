# ==========================================================================
# secrets / credentials — 絶対にコミットしない（該当ファイルは現状無いが事故予防）
# 本当に必要な環境変数は各自のローカル .env に置き、この無視設定で守る。
# ==========================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.keystore
secrets.json
credentials.json
.npmrc.local

# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-electron/
out/
build/
.vite/
*.tsbuildinfo

# test / coverage
coverage/
.vitest/

# electron-builder packaged output
release/

# local / editor
*.local
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# generated: alphaTab assets copied by apps/desktop/scripts/copy-alphatab-assets.mjs
apps/desktop/src/renderer/public/

# OS / runtime data (never committed)
/TabApp/

# machine-local launcher shortcut (absolute paths); use run-app.cmd which is portable
*.lnk
