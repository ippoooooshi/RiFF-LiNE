{
  "$comment": "端末ローカル設定のひな形。settings.local.json にコピーして使う。git 管理から外すこと（.gitignore へ）。絶対パスをここに書かない（環境が変わると壊れ、他人に読まれる）。",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(corepack *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git stash *)",
      "Bash(git fetch *)"
    ]
  },
  "model": "sonnet"
}
