{
  "name": "tab-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "description": "ギター/ベースのタブ譜作成アプリ（モノレポルート）。バージョンの真実源はアプリごと（apps/desktop/package.json 等）。",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @tab-app/desktop dev",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
